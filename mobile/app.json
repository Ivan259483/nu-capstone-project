{
  "expo": {
    "name": "AutoSPF+",
    "slug": "autospf-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "autospfplus",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.autospf.plus",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "AutoSPF+ connects to the Metro JavaScript bundler on your Mac during local development (same Wi‑Fi).",
        "NSCameraUsageDescription": "Camera is used for vehicle scanning and AR damage inspection.",
        "NSMotionUsageDescription": "Motion sensors are used for the AR placement feature in the repair simulation viewer.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "blockedPermissions": [
        "android.permission.VIBRATE"
      ],
      "permissions": [
        "INTERNET",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.autospf.plus",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withIosMetroLanHost.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/autospf-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#050505"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      "expo-image",
      "expo-status-bar",
      "expo-video",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "67bc1336-646f-4a64-b67a-888d73dcb8d9"
      }
    }
  }
}
