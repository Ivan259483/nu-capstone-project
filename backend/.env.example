PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/autospf
# Fallback business timezone when Settings.timezone is absent or invalid.
SHOP_TIME_ZONE=Asia/Manila

# ─── REQUIRED SECRETS ─────────────────────────────────────────────────────
# Server WILL NOT START if either is missing.
# Generate JWT_SECRET:    python3 -c "import os,binascii; print(binascii.hexlify(os.urandom(64)).decode())"
# Generate ENCRYPTION_KEY: python3 -c "import os,binascii; print(binascii.hexlify(os.urandom(16)).decode())"
# ────────────────────────────────────────────────────────────────
JWT_SECRET=<128-char-hex-string>
ENCRYPTION_KEY=
# Previous 32-byte key used only during a controlled key rotation. Remove it
# after the migration dry-run/apply/verification cycle reports no legacy rows.
LEGACY_ENCRYPTION_KEY=

# Comma-separated exact browser origins. `npm run dev` always uses the safe
# development defaults for localhost:5173 / 127.0.0.1:5173 as well.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Provider options: 'resend', 'gmail', 'smtp', or 'console'
EMAIL_PROVIDER=resend

# Professional Email Sender
EMAIL_FROM_NAME=AutoSPF+
EMAIL_FROM_ADDRESS=verify@autospf.shop
EMAIL_REPLY_TO=support@autospf.shop
# Optional: full HTTPS URL to logo image for transactional emails (defaults to CLIENT_URL or CORS first origin + /autospf-logo.jpg). Prefer PNG with transparency or your official wordmark asset so the header matches brand in all clients.
# EMAIL_LOGO_URL=https://autospf.shop/images/autospf-logo.png
# Optional: public app URL for email links and default logo host (falls back to first CORS_ORIGIN or https://autospf.shop)
# CLIENT_URL=https://autospf.shop
# Optional: support address shown in transactional emails
SUPPORT_EMAIL=support@autospf.shop

# ============================================
# GMAIL CONFIGURATION (FALLBACK)
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use app password (16 chars) below
# ============================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

# ============================================
# GENERIC SMTP CONFIGURATION (ALTERNATIVE)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# ============================================
# CHATBOT AI — GROQ (website chat concierge)
# https://console.groq.com/keys
# ============================================
GROQ_API_KEY=your_groq_api_key
# Optional overrides (defaults: llama-3.1-8b-instant, 320 tokens, 30s timeout)
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
# GROQ_CHAT_MAX_TOKENS=320
# GROQ_CHAT_TIMEOUT_MS=30000

# ============================================
# AI DAMAGE DETECTION — ROBOFLOW WORKFLOWS
# Sign up: https://roboflow.com
# Credentials stay on the Express backend. Never use VITE_/NEXT_PUBLIC_ prefixes.
# ============================================
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_WORKSPACE=ivan-tadena
ROBOFLOW_WORKFLOW_ID=vehicle-damage-dataset-vvehicle-damage-dataset-le164-1-yolo11s-seg-t1-logic
# Workflow input name as configured in Roboflow (normally "image")
ROBOFLOW_IMAGE_INPUT=image
# Optional tuning (defaults shown)
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_TIMEOUT_MS=20000
ROBOFLOW_MAX_RETRIES=1
ROBOFLOW_MIN_CONFIDENCE=0.20
ROBOFLOW_MAX_IMAGE_EDGE=1600
# Optional full URL override; normally leave unset.
# ROBOFLOW_WORKFLOW_ENDPOINT=https://serverless.roboflow.com/infer/workflows/ivan-tadena/vehicle-damage-dataset-vvehicle-damage-dataset-le164-1-yolo11s-seg-t1-logic

# ============================================
# 3D GENERATION — MESHY AI
# Sign up: https://meshy.ai
# ============================================
MESHY_API_KEY=your_meshy_api_key
MESHY_API_BASE_URL=https://api.meshy.ai/openapi/v1

# Cloudinary is required for deterministic Meshy image-to-3D
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional unsigned mode if you use an upload preset instead of API secret:
# CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
CLOUDINARY_UPLOAD_FOLDER=vehicle-scans

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_EXPIRY=600
OTP_LENGTH=6
STAFF_VERIFICATION_TOKEN_EXPIRY=86400
PASSWORD_SETUP_TOKEN_EXPIRY=3600

# ============================================
# ONE-TIME ADMINISTRATOR BOOTSTRAP (BACKEND/SECRET STORE ONLY)
# ============================================
# Never prefix these with VITE_, NEXT_PUBLIC_, or EXPO_PUBLIC_.
# Run `npm run bootstrap:administrator -- inspect` before any apply command.
# Remove the initial password from the environment after provisioning succeeds.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_INITIAL_PASSWORD=
# Recommended independent HMAC key for inspection confirmations (server-only).
# If omitted, the backend falls back to JWT_SECRET, then ENCRYPTION_KEY.
BOOTSTRAP_CONFIRMATION_SECRET=
# Required only when explicitly migrating an existing Administrator email.
BOOTSTRAP_ADMIN_MIGRATE_FROM_EMAIL=

# ============================================
# FIREBASE ADMIN SDK (Server-side)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# ============================================
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_CLIENT_EMAIL=<service-account@project.iam.gserviceaccount.com>
FIREBASE_PRIVATE_KEY="<firebase-private-key-with-escaped-newlines>"

# ============================================
# LOCAL HTTPS (mkcert) — mobile WebAR / getUserMedia on LAN
# ============================================
# After: mkcert -install && mkcert 192.168.x.x localhost 127.0.0.1
# HTTPS_KEY_PATH=/absolute/path/to/_wildcard.your-key.pem
# HTTPS_CERT_PATH=/absolute/path/to/_wildcard.your.pem
# PORT=8080
# Point NEXT_PUBLIC_API_URL at https://<host>:<PORT> (see frontend/.env.local.example).
